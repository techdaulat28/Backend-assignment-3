  "item": [
    {
      "name": "Health / API Root",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": [
            "{{baseUrl}}"
          ]
        }
      }
    },
    {
      "name": "Create Product",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Wireless Mouse\",\n  \"sku\": \"WM-1001\",\n  \"category\": \"Electronics\",\n  \"price\": 799,\n  \"stock\": 25,\n  \"lowStockThreshold\": 10,\n  \"supplier\": \"Tech Supplies Ltd\",\n  \"description\": \"2.4 GHz wireless mouse\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products"
          ]
        }
      }
    },
    {
      "name": "Get All Products - Filter Sort Pagination",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products?category=Electronics&minPrice=100&maxPrice=2000&sortBy=price&order=asc&page=1&limit=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products"
          ],
          "query": [
            {
              "key": "category",
              "value": "Electronics"
            },
            {
              "key": "minPrice",
              "value": "100"
            },
            {
              "key": "maxPrice",
              "value": "2000"
            },
            {
              "key": "sortBy",
              "value": "price"
            },
            {
              "key": "order",
              "value": "asc"
            },
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
            }
          ]
        }
